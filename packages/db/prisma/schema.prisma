// Database-backed sessions instead of next-auth's Credentials+JWT default:
// plan.md section 5 requires that an admin can revoke a session server-side
// (role change, deactivation), which next-auth's Credentials provider can't
// do with database sessions — so auth is implemented directly against this
// schema (see apps/main/src/lib/auth) rather than through next-auth.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  coach
  player
  referee
}

enum Capability {
  teamindeling
  statistieken
  vastspelen
}

enum Seizoensdeel {
  veld
  zaal
}

enum AuditAction {
  role_changed
  club_changed
  capabilities_changed
  password_reset
  user_deactivated
  user_activated
  user_deleted
  user_invited
  app_config_changed
  maintenance_mode_changed
  club_created
  club_updated
  club_deleted
  club_join_requested
  club_join_approved
  club_join_rejected
  club_manager_changed
  club_activated
  club_deactivated
}

model Club {
  id        String   @id @default(cuid())
  naam      String
  code      String?  @unique
  refId     String?  @unique
  active    Boolean  @default(true)

  latitude  Float?
  longitude Float?

  addressName            String?
  addressType            String?
  addressDescription     String?
  streetName             String?
  addressNumber          Int?
  addressNumberAppendix  String?
  postalCode             String?
  city                   String?
  country                String?
  countryCode            String?

  veldPoolName String?
  veldPoolId   Int?
  zaalPoolName String?
  zaalPoolId   Int?

  clusterId   String?
  clusterName String?
  regioId     Int?
  regioName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]           @relation("ClubMembers")
  pendingRequests User[]           @relation("ClubPendingRequests")
  vastspelenTeams VastspelenTeam[]
  teams           Team[]
  players         Player[]
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  naam          String?
  passwordHash  String
  role          Role         @default(player)
  capabilities  Capability[] @default([])
  clubId        String?
  club          Club?        @relation("ClubMembers", fields: [clubId], references: [id])
  // Requested-but-not-yet-approved club (see requireClubManager /
  // /api/admin/club-requests) — separate from clubId so the user's actual
  // membership stays untouched while a request is pending. SetNull (not the
  // implicit restrict that clubId gets) because losing a stale pending
  // request when its target club is deleted is harmless — the user just
  // requests again — whereas blocking the club delete would not be.
  pendingClubId   String?
  pendingClub     Club?        @relation("ClubPendingRequests", fields: [pendingClubId], references: [id], onDelete: SetNull)
  isClubBeheerder Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deactivatedAt DateTime?
  emailVerifiedAt DateTime?
  consentedAt     DateTime?

  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  auditLogsAsActor        AuditLog[]               @relation("AuditLogActor")
  auditLogsAsTarget       AuditLog[]               @relation("AuditLogTarget")

  @@index([clubId])
  @@index([pendingClubId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Fixed-window rate limiting, Postgres-backed instead of Redis/Upstash to
// avoid a new external dependency (see the DB-backed-sessions rationale at
// the top of this file — same philosophy). key is e.g. "login:ip:1.2.3.4" or
// "login:email:foo@bar.com"; windowStart buckets requests into fixed windows.
model RateLimitAttempt {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}

// One row per Capability (see enum above) — homepage (apps/main) renders the
// "Apps" grid from this table, admin settings page manages it. Rows are
// created lazily (upserted) the first time an admin fetches the list, so
// adding a new value to the Capability enum doesn't require a data migration.
model AppConfig {
  capability Capability @id
  title      String
  imageUrl   String?
  visible    Boolean    @default(true)
  updatedAt  DateTime   @updatedAt
}

// Single-row platform-wide settings. Always read/written through id
// "singleton" — see apps/main's require-settings-style helper — so there's
// never more than one row to reconcile.
model PlatformSettings {
  id              String   @id @default("singleton")
  maintenanceMode Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id            String      @id @default(cuid())
  // Nullable + SetNull: a user can now be hard-deleted (see "verwijderen" in
  // the admin UI), and the audit trail must survive that rather than block
  // the delete or vanish with it.
  actorId       String?
  actor         User?       @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  action        AuditAction
  targetUserId  String?
  targetUser    User?       @relation("AuditLogTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  metadata      Json        @default("{}")
  createdAt     DateTime    @default(now())

  @@index([actorId])
  @@index([targetUserId])
}

// --- Vastspelen-tool (A-categorie, 1e/2e team) — see docs/apps/vastspelen-plan.md ---
// Models are prefixed "Vastspelen" since this schema is shared across every
// tool app; only apps/main reads/writes these (docs/plan.md section 5/14).

model VastspelenTeam {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  niveau    Int // 1 of 2
  categorie String   @default("A")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spelers          VastspelenPlayer[]
  fixtures         VastspelenFixture[]
  invalAppearances VastspelenAppearance[] @relation("AppearanceGespeeldInTeam")

  @@unique([clubId, niveau, categorie])
  @@index([clubId])
}

model VastspelenPlayer {
  id            String   @id @default(cuid())
  naam          String
  geboortedatum DateTime
  teamId        String
  team          VastspelenTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appearances VastspelenAppearance[]

  @@index([teamId])
}

// One row per seizoensdeel (veld/zaal instantie, bv. "Veld 2026") — de
// laatste-3-wedstrijden- en driekwart-competitie-regels tellen altijd binnen
// zo'n periode, nooit seizoensdeel-overstijgend (zie plan sectie "Uitgangspunten").
model VastspelenSeasonPeriod {
  id                String       @id @default(cuid())
  naam              String
  seizoensdeel      Seizoensdeel
  start             DateTime
  eind              DateTime
  totaalWedstrijden Int

  fixtures VastspelenFixture[]

  @@index([seizoensdeel])
}

model VastspelenFixture {
  id             String   @id @default(cuid())
  // Voor idempotente Programma-API-sync (zie plan) — nullable zolang
  // wedstrijden ook handmatig aangemaakt kunnen worden.
  externalId     String?  @unique
  teamId         String
  team           VastspelenTeam         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  seasonPeriodId String
  seasonPeriod   VastspelenSeasonPeriod @relation(fields: [seasonPeriodId], references: [id], onDelete: Cascade)
  tegenstander   String
  datum          DateTime
  poule          String?
  speelweek      Int
  wedstrijdduur  Int      @default(60) // minuten
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appearances VastspelenAppearance[]

  @@index([teamId])
  @@index([seasonPeriodId])
}

model VastspelenAppearance {
  id     String @id @default(cuid())
  fixtureId String
  fixture   VastspelenFixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  playerId  String
  player    VastspelenPlayer  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  // Team waarin dit daadwerkelijk gespeeld is — kan afwijken van player.teamId
  // bij een invalbeurt (zie plan: max. 2 invallers per wedstrijd vanuit lager team).
  gespeeldInTeamId String
  gespeeldInTeam   VastspelenTeam @relation("AppearanceGespeeldInTeam", fields: [gespeeldInTeamId], references: [id])
  minuten          Int
  createdAt        DateTime @default(now())

  @@unique([fixtureId, playerId])
  @@index([fixtureId])
  @@index([playerId])
  @@index([gespeeldInTeamId])
}

enum TeamType {
  jeugd
  senioren
}

enum Gender {
  m
  v
}

model Team {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  naam      String
  type      TeamType
  categorie String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players Player[]

  @@index([clubId])
}

model Player {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  naam      String
  geslacht  Gender
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
  @@index([teamId])
}

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/korfbaltools?pgbouncer=true"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/korfbaltools"

# Apps aan/uit. Alles wat niet exact "true" is staat uit: geen link in de
# toolbar, geen tegel op de homepage, en de route geeft 404.
APP_TEAMINDELING_ENABLED="true"
APP_SCOREFORMULIER_ENABLED="true"
APP_VASTSPELEN_ENABLED="false"
APP_STATISTIEKEN_ENABLED="false"
APP_MIJN_CLUB_ENABLED="false"

# Club-context voor vastspelen en mijn-club. Die data is club-gescoped en er
# zijn geen accounts meer om de club uit af te leiden, dus zonder deze waarde
# geven die API-routes een 403.
DEFAULT_CLUB_ID=""

# Public URL van de app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local dev only: apps/main rewrites /teamindeling/* here (see next.config.mjs).
TEAMINDELING_APP_URL="http://localhost:3002"

# Local dev only: apps/main rewrites /vastspelen/* here (see next.config.mjs).
VASTSPELEN_APP_URL="http://localhost:3003"

# Local dev only: apps/main rewrites /scoreformulier/* here (see next.config.mjs).
SCOREFORMULIER_APP_URL="http://localhost:3004"

# Google Analytics measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable GA.
NEXT_PUBLIC_GA_ID=""
